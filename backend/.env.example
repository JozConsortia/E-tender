PORT=5000
JWT_SECRET=replace-this-demo-secret
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# MySQL connection string used by Prisma
DATABASE_URL="mysql://user:password@localhost:3306/etender"

# Google Gemini API key, used by the AI Document Assessment feature (admin only)
GEMINI_API_KEY=

# Optional: outbound email for security alerts (SecurityAlert). If any of these
# are missing, alerts are still recorded in-app but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
